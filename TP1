      "source": [
        "### Part 3: List References vs. List Copies"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "0a962952"
      },
      "source": [
        "rgb = [\"R\", \"G\", \"B\"]\n",
        "rgb_copy = rgb  # This is NOT a copy; it is a reference alias pointing to the exact same list!\n",
        "rgb_copy.append(\"A\")\n",
        "\n",
        "# Let's inspect the outputs\n",
        "print(\"rgb_copy:\", rgb_copy)\n",
        "print(\"rgb:\", rgb)  # Notice that 'rgb' also changed because they share the same memory address\n",
        "print(\"id(rgb) == id(rgb_copy):\", id(rgb) == id(rgb_copy))"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "48411ae1"
      },
      "source": [
        "By slicing (`rgb[:]`), we create a brand new shallow copy of the list object, meaning changes to the copy will not affect the original list:"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "f70f5fa2"
      },
      "source": [
        "rgb = [\"R\", \"G\", \"B\"]\n",
        "correct_rgb_copy = rgb[:]  # This creates an independent shallow copy!\n",
        "correct_rgb_copy.append(\"A\")\n",
        "\n",
        "# Let's inspect the outputs now\n",
        "print(\"correct_rgb_copy:\", correct_rgb_copy)\n",
        "print(\"rgb:\", rgb)  # Notice that 'rgb' remains unchanged!\n",
        "print(\"id(rgb) == id(correct_rgb_copy):\", id(rgb) == id(correct_rgb_copy))"
      ],
      "execution_count": null,
      "outputs": []
    },

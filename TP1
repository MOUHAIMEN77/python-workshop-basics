      "source": [
        "### Exploring String Slicing, Immutability, and Methods"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "76994941"
      },
      "source": [
        "p = \"Python\"\n",
        "c = \"Coding\"\n",
        "\n",
        "# --- 1. Slicing and Indexing ---\n",
        "# This will raise an IndexError because index 6 is out of bounds (indices are 0 to 5 for \"Python\").\n",
        "try:\n",
        "    print(p[6])\n",
        "except IndexError as e:\n",
        "    print(f\"p[6] Error: {e}\")\n",
        "\n",
        "# Slicing is more forgiving; index 6 is out of bounds but it simply returns an empty string \"\"\n",
        "print(f\"p[6:] slice result: '{p[6:]}'\")"
      ],
      "execution_count": null,
      "outputs": []
    },

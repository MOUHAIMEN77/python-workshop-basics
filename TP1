        "### Part 6: Student Grades Analysis with Zip, Sets, and Dictionaries"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "474107bb"
      },
      "source": [
        "# Define lists\n",
        "students = [\"Alice\", \"Bob\", \"Charlie\", \"David\", \"Eve\"]\n",
        "grades = [85, 90, 78, 92, 90]\n",
        "\n",
        "# Remove duplicates from grades list using a set\n",
        "unique_grades = set(grades)\n",
        "\n",
        "# Find the highest grade using \"max()\" function\n",
        "highest_grade = max(grades)\n",
        "\n",
        "# Create the dictionary using zip()\n",
        "student_grades = dict(zip(students, grades))\n",
        "\n",
        "# Find list of student(s) who got the highest grade\n",
        "top_students = [student for student, grade in student_grades.items() if grade == highest_grade]\n",
        "\n",
        "# Print results\n",
        "print(\"Student Grades Dictionary:\", student_grades)\n",
        "print(\"Unique Grades Set:\", unique_grades)\n",
        "print(\"Highest Grade:\", highest_grade)\n",
        "print(\"Top Student(s):\", top_students)"
      ],
      "execution_count": null,
      "outputs": []
    }

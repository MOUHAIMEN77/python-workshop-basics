        "### Part 4: Counting Positive Numbers"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8b866ac0"
      },
      "source": [
        "# Sample list of numbers\n",
        "numbers = [-3, 5, -1, 7, 0, -8, 10]\n",
        "\n",
        "# Initialize the counter for positive numbers\n",
        "positive_count = 0\n",
        "\n",
        "# Loop through each number in the list\n",
        "for num in numbers:\n",
        "    # Check if the number is positive\n",
        "    if num > 0:\n",
        "        positive_count += 1\n",
        "\n",
        "# Print the result\n",
        "print(f\"Count of positive numbers: {positive_count}\")"
      ],
      "execution_count": null,

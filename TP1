        "### Part 5: Filtering Even Numbers with a Function"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "dacaebc6"
      },
      "source": [
        "def filter_even_numbers(numbers):\n",
        "    \"\"\"\n",
        "    Returns a list of even numbers from a list.\n",
        "    \"\"\"\n",
        "    result = []\n",
        "    for num in numbers:\n",
        "        if num % 2 == 0:\n",
        "            result.append(num)\n",
        "    return result\n",
        "\n",
        "# Test the function\n",
        "test_list = [1, 2, 3, 4, 5, 6, 7, 8]\n",
        "even_numbers = filter_even_numbers(test_list)\n",
        "print(f\"Original list: {test_list}\")\n",
        "print(f\"Filtered even numbers: {even_numbers}\")"
      ],
      "execution_count": null,
